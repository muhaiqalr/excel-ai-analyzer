# ===========================================
# Excel AI Analyzer Backend - Environment Variables
# ===========================================

# --- Database ---
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=excel_ai_analyzer
DB_USER=root
DB_PASSWORD=

# --- Authentication ---
JWT_SECRET=change_this_to_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# --- AI Provider ---
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Environment ---
ENVIRONMENT=development
