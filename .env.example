# ===========================================
# Excel AI Analyzer - Environment Variables
# ===========================================

# --- Database ---
# For SQLite (default): leave DATABASE_URL empty, DB_HOST=localhost
# For MySQL: set DATABASE_URL or individual DB_* vars
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=excel_ai_analyzer
DB_USER=root
DB_PASSWORD=

# --- Authentication ---
# Generate a secure random string for JWT signing
# Python: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_this_to_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# --- AI Provider ---
# Gemini API key from https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# --- URLs ---
# Production: https://your-domain.com
# Development: http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Environment ---
# Set to "production" for live deployment
# Leave empty or "development" for local development
ENVIRONMENT=development
